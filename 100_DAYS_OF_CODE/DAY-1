#include <stdio.h>

int main() {
    int n, digit;
    int found[10] = {0};

    printf("Enter a number: ");
    scanf("%d", &n);

    while (n > 0) {
        digit = n % 10;
        found[digit] = 1;
        n = n / 10;
    }

    for (int i = 0; i <= 9; i++) {
        if (found[i] == 0) {
            printf("%d", i);
            break;
        }
    }

    return 0;
}