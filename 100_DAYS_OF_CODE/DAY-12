#include <stdio.h>

int removeDuplicates(int arr[], int n) {
    if (n == 0)
        return 0;

    int j = 0;

    for (int i = 1; i < n; i++) {
        if (arr[i] != arr[j]) {
            j++;
            arr[j] = arr[i];
        }
    }

    return j + 1;
}

int main() {
    int arr[] = {5, 5, 7, 8, 8, 9, 9, 10, 10};
    int n = 9;

    int newSize = removeDuplicates(arr, n);

    printf("Array after removing duplicates: ");

    for (int i = 0; i < newSize; i++) {
        printf("%d ", arr[i]);
    }

    printf("\nNumber of unique elements = %d", newSize);

    return 0;
}